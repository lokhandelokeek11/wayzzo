# Environment Variables Example

# General Application Environments
NODE_ENV=development

# Web Applications Ports
PORT_BUSINESS_WEBSITE=3000
PORT_MERCHANT_PORTAL=3001
PORT_SUPER_ADMIN_PORTAL=3002

# Future Backend / API Configuration
API_BASE_URL=http://localhost:4000/api/v1
SOCKET_BASE_URL=http://localhost:4000

# Database Configuration (Future Backend)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/delivery_platform?schema=public"
REDIS_URL="redis://localhost:6379"

# Authentication & JWT Secrets
JWT_SECRET=super-secret-jwt-key-replace-in-production
JWT_EXPIRY=7d

# Third-party Integrations (Maps, Payments, SMS)
MAPS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
SMS_GATEWAY_API_KEY=
