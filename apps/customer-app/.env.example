# Wayzzo Customer App Environment Variables
# Variables prefixed with EXPO_PUBLIC_ are bundled into client code.
# Secrets (e.g. backend service keys, database passwords) must NEVER be stored here.

# API Base URL for backend endpoints
EXPO_PUBLIC_API_URL=https://api.wayzzo.com/v1

# Google Maps API Key (leave empty or use placeholder for dev fallback)
EXPO_PUBLIC_MAPS_API_KEY=

# Application Environment (development | preview | production)
EXPO_PUBLIC_APP_ENV=development

