{
  "expo": {
    "name": "Wayzo Partner",
    "slug": "wayzo-partner",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "wayzo-partner",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1e293b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "delivery.wayzo.partner"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1e293b"
      },
      "package": "delivery.wayzo.partner",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "CAMERA"
      ]
    },
    "plugins": ["expo-router", "expo-font", "expo-location"],
    "experiments": {
      "typedRoutes": true
    }
  }
}

